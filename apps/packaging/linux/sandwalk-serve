#!/bin/sh
# Start the Sandwalk agent for the systemd user service.
# Prefer the CLI shipped in this package (/usr/bin/sandwalk). A user install
# or checkout venv is only a fallback.
set -eu

if [ -n "${SANDWALK_BIN:-}" ] && [ -x "${SANDWALK_BIN}" ]; then
  exec "${SANDWALK_BIN}" serve --host 127.0.0.1 --port 8787
fi

# The package wrapper only works when this deb also shipped the Python runtime.
if [ -x /usr/bin/sandwalk ] && { [ -x /usr/lib/sandwalk/agent-runtime/bin/python3.12 ] || [ -x /usr/lib/sandwalk/agent-runtime/bin/python3 ]; }; then
  exec /usr/bin/sandwalk serve --host 127.0.0.1 --port 8787
fi

home="${HOME:-}"
if [ -z "$home" ]; then
  home="$(getent passwd "$(id -u)" | cut -d: -f6)"
fi

for candidate in \
  "${home}/.local/bin/sandwalk" \
  "${home}/Projects/sandwalk/cli/.venv/bin/sandwalk"
do
  if [ -x "$candidate" ]; then
    exec "$candidate" serve --host 127.0.0.1 --port 8787
  fi
done

if command -v sandwalk >/dev/null 2>&1; then
  found="$(command -v sandwalk)"
  if [ "$found" != /usr/bin/sandwalk ]; then
    exec "$found" serve --host 127.0.0.1 --port 8787
  fi
fi

echo "sandwalk CLI not found. Install it in this account, then restart the service." >&2
exit 1
