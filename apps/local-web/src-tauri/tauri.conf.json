{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sandwalk",
  "version": "0.1.0-beta.1",
  "identifier": "ai.fastfold.sandwalk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm exec vite --port 1420 --strictPort",
    "beforeBuildCommand": "pnpm exec vite build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": false,
    "publisher": "Fastfold AI Labs",
    "copyright": "© 2026 Fastfold AI Labs. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzODFFMTU3QURDNTMzNzMKUldSek04V3RWK0dCZzZSaFBDQmhvKzh2S0Z0c1V0cFhSNkFkUFVjU09VUDFnUVhHcERidDZnVVoK",
      "endpoints": [
        "https://github.com/fastfold-ai/sandwalk/releases/latest/download/latest.json"
      ]
    }
  }
}
