# Optional environment variables for local development / Docker.
# Copy to `.env` and fill in values you need. Never commit real secrets.

# Model providers (any one is enough to start)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Optional OpenAI-compatible providers
# XAI_API_KEY=
# GEMINI_API_KEY=
# NVIDIA_API_KEY=

# Optional FastFold / structure tools
# FASTFOLD_API_KEY=
# BOLTZ_API_KEY=

# Optional search / ops
# TAVILY_API_KEY=
# LANGSMITH_API_KEY=
